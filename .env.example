# ========================================================
# LUMORA ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and provide your credentials.
# ========================================================

# --------------------------------------------------------
# 1. SERVER-ONLY SECRETS (Never prefix with VITE_)
# --------------------------------------------------------
# Gemini API Key for server-side multi-modal analysis & story synthesis
GEMINI_API_KEY=""

# Cloudinary API Secret (Optional, kept server-side only for signed admin operations)
CLOUDINARY_API_SECRET=""

# Server port (Defaults to 3000)
PORT="3000"

# --------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Safe for browser bundle)
# --------------------------------------------------------
# Cloudinary Unsigned Upload Configuration
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Firebase Web App Configuration (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
