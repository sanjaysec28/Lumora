rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Memory documents (Each document has ownerId matching authenticated user)
    match /memories/{memoryId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Subcollections nested within memories
      match /media/{mediaId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/memories/$(memoryId)).data.ownerId == request.auth.uid;
      }

      match /moments/{momentId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/memories/$(memoryId)).data.ownerId == request.auth.uid;
      }

      match /conversations/{conversationId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/memories/$(memoryId)).data.ownerId == request.auth.uid;
      }

      match /clusters/{clusterId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/memories/$(memoryId)).data.ownerId == request.auth.uid;

        match /story/{storyId} {
          allow read, write: if isAuthenticated() && 
            get(/databases/$(database)/documents/memories/$(memoryId)).data.ownerId == request.auth.uid;
        }
      }
    }

    // Top-level clusters collection
    match /clusters/{clusterId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /story/{storyId} {
        allow read, write: if isAuthenticated() && 
          get(/databases/$(database)/documents/clusters/$(clusterId)).data.ownerId == request.auth.uid;
      }
    }

    // Top-level story capsules collection
    match /storyCapsules/{capsuleId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
